<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="confirmDialog" title="Review" class="sapUiSizeCompact" stretchOnPhone="true">
    <content>
      <Page id="nestedPage" showHeader="true" title="Nested Page (sap.m.Page — seed control)">
        <content>
          <Text text="Dialog + Page pattern: use for confirmations in Fiori apps. This dialog is opened from the header action." class="sapUiSmallMargin" />
        </content>
        <footer>
          <OverflowToolbar>
            <ToolbarSpacer />
            <Button type="Emphasized" text="Close" press=".onCloseDialog" />
          </OverflowToolbar>
        </footer>
      </Page>
    </content>
  </Dialog>
</core:FragmentDefinition>
