<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  xmlns="sap.m"
  controllerName="subdemo.controller.Subscription"
  displayBlock="true"
  height="100%">
  <App id="subApp" busyIndicatorDelay="0">
    <pages>
      <Page
        title="B2B Subscription Management"
        class="sapUiContentPadding"
        showNavButton="false"
        enableScrolling="true"
        backgroundDesign="Standard">
        <content>
          <MessageStrip
            text="Manage B2B subscriptions with comprehensive billing, pricing, and payment options."
            type="Information"
            showIcon="true"
            class="sapUiSmallMarginBottom"
          />

          <!-- Layout Toggle -->
          <Panel headerText="Layout Options" expandable="false" expanded="true" class="sapUiSmallMarginBottom">
            <content>
              <HBox alignItems="Center">
                <Text text="Horizontal Layout Mode: " class="sapUiSmallMarginEnd" />
                <Switch state="{sub>/horizontalLayoutMode}" change=".onLayoutToggle" />
              </HBox>
            </content>
          </Panel>

          <!-- Horizontal: Subscriber & Subscription Details -->
          <Panel headerText="Subscriber &amp; Subscription Details" expandable="false" expanded="true" class="sapUiSmallMarginBottom" visible="{sub>/horizontalLayoutMode}">
            <content>
              <HBox>
                <VBox class="sapUiSmallMarginEnd" width="50%">
                  <Panel headerText="Subscriber Information" expandable="false" expanded="true">
                    <content>
                      <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                        <Label text="Subscription ID" />
                        <Input value="{sub>/subscriber/id}" placeholder="SUB-2026-001" />
                        <Label text="Company Name" />
                        <Input value="{sub>/subscriber/companyName}" required="true" placeholder="Company Name" />
                        <Label text="Contact Person" />
                        <Input value="{sub>/subscriber/contactPerson}" placeholder="Contact Person" />
                        <Label text="Email" />
                        <Input value="{sub>/subscriber/email}" type="Email" placeholder="contact@company.com" />
                        <Label text="Phone" />
                        <Input value="{sub>/subscriber/phone}" type="Tel" placeholder="+1 234 567 890" />
                        <Label text="Customer Type" />
                        <Select selectedKey="{sub>/subscriber/customerType}">
                          <items>
                            <core:Item key="enterprise" text="Enterprise" />
                            <core:Item key="sme" text="SME" />
                            <core:Item key="startup" text="Startup" />
                          </items>
                        </Select>
                        <Label text="Address" />
                        <TextArea value="{sub>/subscriber/address}" rows="2" placeholder="Street, City, Country" />
                        <Label text="VAT ID" />
                        <Input value="{sub>/subscriber/vatId}" placeholder="VAT Number" />
                      </form:SimpleForm>
                    </content>
                  </Panel>
                </VBox>
                <VBox width="50%">
                  <Panel headerText="Subscription Details" expandable="false" expanded="true">
                    <content>
                      <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                        <Label text="Subscription Plan" />
                        <ComboBox selectedKey="{sub>/subscription/plan}" change=".onPlanChange">
                          <items>
                            <core:Item key="basic" text="Basic" />
                            <core:Item key="professional" text="Professional" />
                            <core:Item key="enterprise" text="Enterprise" />
                            <core:Item key="custom" text="Custom" />
                          </items>
                        </ComboBox>
                        <Label text="Billing Frequency" />
                        <Select selectedKey="{sub>/subscription/billingFrequency}" change=".onBillingChange">
                          <items>
                            <core:Item key="monthly" text="Monthly" />
                            <core:Item key="quarterly" text="Quarterly" />
                            <core:Item key="annually" text="Annually" />
                            <core:Item key="custom" text="Custom" />
                          </items>
                        </Select>
                        <Label text="Pricing Model" />
                        <Select selectedKey="{sub>/subscription/pricingModel}" change=".onPricingChange">
                          <items>
                            <core:Item key="fixed" text="Fixed Price" />
                            <core:Item key="tiered" text="Tiered Pricing" />
                            <core:Item key="usage" text="Usage-based" />
                            <core:Item key="per-seat" text="Per-seat" />
                          </items>
                        </Select>
                        <Label text="Start Date" />
                        <DatePicker value="{sub>/subscription/startDate}" change=".onDateChange" />
                        <Label text="End Date" />
                        <DatePicker value="{sub>/subscription/endDate}" change=".onDateChange" />
                        <Label text="Auto-renew" />
                        <Switch state="{sub>/subscription/autoRenew}" change=".onAutoRenewChange" />
                        <Label text="Free Trial" />
                        <CheckBox selected="{sub>/subscription/freeTrial}" select=".onTrialChange" />
                        <Label text="Trial Days" />
                        <Input value="{sub>/subscription/trialDays}" type="Number" placeholder="30" />
                        <Label text="Seat Count" />
                        <Input value="{sub>/subscription/seatCount}" type="Number" placeholder="10" liveChange=".onSeatChange" />
                        <Label text="Usage Quota" />
                        <Input value="{sub>/subscription/usageQuota}" type="Number" placeholder="1000" liveChange=".onUsageChange" />
                      </form:SimpleForm>
                    </content>
                  </Panel>
                </VBox>
              </HBox>
            </content>
          </Panel>

          <!-- Vertical: Subscriber Information -->
          <Panel headerText="Subscriber Information" expandable="false" expanded="true" class="sapUiSmallMarginBottom" visible="{path: 'sub>/horizontalLayoutMode', formatter: '.formatInverted'}">
            <content>
              <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                <Label text="Subscription ID" />
                <Input value="{sub>/subscriber/id}" placeholder="SUB-2026-001" />
                <Label text="Company Name" />
                <Input value="{sub>/subscriber/companyName}" required="true" placeholder="Company Name" />
                <Label text="Contact Person" />
                <Input value="{sub>/subscriber/contactPerson}" placeholder="Contact Person" />
                <Label text="Email" />
                <Input value="{sub>/subscriber/email}" type="Email" placeholder="contact@company.com" />
                <Label text="Phone" />
                <Input value="{sub>/subscriber/phone}" type="Tel" placeholder="+1 234 567 890" />
                <Label text="Customer Type" />
                <Select selectedKey="{sub>/subscriber/customerType}">
                  <items>
                    <core:Item key="enterprise" text="Enterprise" />
                    <core:Item key="sme" text="SME" />
                    <core:Item key="startup" text="Startup" />
                  </items>
                </Select>
                <Label text="Address" />
                <TextArea value="{sub>/subscriber/address}" rows="2" placeholder="Street, City, Country" />
                <Label text="VAT ID" />
                <Input value="{sub>/subscriber/vatId}" placeholder="VAT Number" />
              </form:SimpleForm>
            </content>
          </Panel>

          <!-- Vertical: Subscription Details -->
          <Panel headerText="Subscription Details" expandable="false" expanded="true" class="sapUiSmallMarginBottom" visible="{path: 'sub>/horizontalLayoutMode', formatter: '.formatInverted'}">
            <content>
              <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                <Label text="Subscription Plan" />
                <ComboBox selectedKey="{sub>/subscription/plan}" change=".onPlanChange">
                  <items>
                    <core:Item key="basic" text="Basic" />
                    <core:Item key="professional" text="Professional" />
                    <core:Item key="enterprise" text="Enterprise" />
                    <core:Item key="custom" text="Custom" />
                  </items>
                </ComboBox>
                <Label text="Billing Frequency" />
                <Select selectedKey="{sub>/subscription/billingFrequency}" change=".onBillingChange">
                  <items>
                    <core:Item key="monthly" text="Monthly" />
                    <core:Item key="quarterly" text="Quarterly" />
                    <core:Item key="annually" text="Annually" />
                    <core:Item key="custom" text="Custom" />
                  </items>
                </Select>
                <Label text="Pricing Model" />
                <Select selectedKey="{sub>/subscription/pricingModel}" change=".onPricingChange">
                  <items>
                    <core:Item key="fixed" text="Fixed Price" />
                    <core:Item key="tiered" text="Tiered Pricing" />
                    <core:Item key="usage" text="Usage-based" />
                    <core:Item key="per-seat" text="Per-seat" />
                  </items>
                </Select>
                <Label text="Start Date" />
                <DatePicker value="{sub>/subscription/startDate}" change=".onDateChange" />
                <Label text="End Date" />
                <DatePicker value="{sub>/subscription/endDate}" change=".onDateChange" />
                <Label text="Auto-renew" />
                <Switch state="{sub>/subscription/autoRenew}" change=".onAutoRenewChange" />
                <Label text="Free Trial" />
                <CheckBox selected="{sub>/subscription/freeTrial}" select=".onTrialChange" />
                <Label text="Trial Days" />
                <Input value="{sub>/subscription/trialDays}" type="Number" placeholder="30" />
                <Label text="Seat Count" />
                <Input value="{sub>/subscription/seatCount}" type="Number" placeholder="10" liveChange=".onSeatChange" />
                <Label text="Usage Quota" />
                <Input value="{sub>/subscription/usageQuota}" type="Number" placeholder="1000" liveChange=".onUsageChange" />
              </form:SimpleForm>
            </content>
          </Panel>

          <!-- Plan Comparison Table -->
          <Panel headerText="Plan Comparison" expandable="false" expanded="true" class="sapUiSmallMarginBottom">
            <content>
              <Table id="planTable" mode="SingleSelect" selectionChange=".onPlanSelect">
                <columns>
                  <Column><Text text="Plan" /></Column>
                  <Column><Text text="Features" /></Column>
                  <Column><Text text="Price/Month" /></Column>
                  <Column><Text text="Price/Quarter" /></Column>
                  <Column><Text text="Price/Year" /></Column>
                </columns>
                <items>
                  <ColumnListItem type="Active">
                    <cells>
                      <Text text="Basic" />
                      <Text text="10 users, Basic support" />
                      <Text text="€99" />
                      <Text text="€297" />
                      <Text text="€1,188" />
                    </cells>
                  </ColumnListItem>
                  <ColumnListItem type="Active">
                    <cells>
                      <Text text="Professional" />
                      <Text text="50 users, Priority support" />
                      <Text text="€299" />
                      <Text text="€897" />
                      <Text text="€3,588" />
                    </cells>
                  </ColumnListItem>
                  <ColumnListItem type="Active">
                    <cells>
                      <Text text="Enterprise" />
                      <Text text="Unlimited, 24/7 support" />
                      <Text text="€999" />
                      <Text text="€2,997" />
                      <Text text="€11,988" />
                    </cells>
                  </ColumnListItem>
                  <ColumnListItem type="Active">
                    <cells>
                      <Text text="Custom" />
                      <Text text="Tailored to your needs" />
                      <Text text="Contact Sales" />
                      <Text text="Contact Sales" />
                      <Text text="Contact Sales" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </content>
          </Panel>

          <!-- Horizontal: Billing & Payment & Summary -->
          <Panel headerText="Billing, Payment &amp; Summary" expandable="true" expanded="true" class="sapUiSmallMarginBottom" visible="{sub>/horizontalLayoutMode}">
            <content>
              <HBox>
                <VBox class="sapUiSmallMarginEnd">
                  <Panel headerText="Billing Information" expandable="false" expanded="true">
                    <content>
                      <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                        <Label text="Currency" />
                        <Select selectedKey="{sub>/billing/currency}" change=".onCurrencyChange">
                          <items>
                            <core:Item key="EUR" text="EUR" />
                            <core:Item key="USD" text="USD" />
                            <core:Item key="GBP" text="GBP" />
                          </items>
                        </Select>
                        <Label text="Tax Rate (%)" />
                        <Input value="{sub>/billing/taxRate}" type="Number" placeholder="20" liveChange=".onTaxChange" />
                        <Label text="Tax Exempt" />
                        <CheckBox selected="{sub>/billing/taxExempt}" select=".onTaxExemptChange" />
                        <Label text="Invoice Frequency" />
                        <Select selectedKey="{sub>/billing/invoiceFrequency}">
                          <items>
                            <core:Item key="monthly" text="Monthly" />
                            <core:Item key="quarterly" text="Quarterly" />
                            <core:Item key="annually" text="Annually" />
                          </items>
                        </Select>
                        <Label text="Payment Method" />
                        <Select selectedKey="{sub>/billing/paymentMethod}" change=".onPaymentMethodChange">
                          <items>
                            <core:Item key="creditcard" text="Credit Card" />
                            <core:Item key="banktransfer" text="Bank Transfer" />
                            <core:Item key="paypal" text="PayPal" />
                            <core:Item key="invoice" text="Invoice" />
                          </items>
                        </Select>
                        <Label text="PO Number" />
                        <Input value="{sub>/billing/poNumber}" placeholder="PO-12345" />
                        <Label text="Billing Contact" />
                        <Input value="{sub>/billing/billingContact}" placeholder="Billing Contact" />
                        <Label text="Billing Email" />
                        <Input value="{sub>/billing/billingEmail}" type="Email" placeholder="billing@company.com" />
                      </form:SimpleForm>
                    </content>
                  </Panel>
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                  <Panel headerText="Payment Method Details" expandable="false" expanded="true">
                    <content>
                      <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                        <Label text="Card Number" />
                        <Input value="{sub>/payment/cardNumber}" placeholder="**** **** **** 1234" />
                        <Label text="Card Expiry" />
                        <Input value="{sub>/payment/cardExpiry}" placeholder="MM/YY" />
                        <Label text="Card CVV" />
                        <Input value="{sub>/payment/cardCvv}" placeholder="***" />
                        <Label text="Bank Account" />
                        <Input value="{sub>/payment/bankAccount}" placeholder="IBAN" />
                        <Label text="Bank BIC/SWIFT" />
                        <Input value="{sub>/payment/bankBic}" placeholder="BIC/SWIFT" />
                        <Label text="PayPal Email" />
                        <Input value="{sub>/payment/paypalEmail}" type="Email" placeholder="paypal@company.com" />
                      </form:SimpleForm>
                    </content>
                  </Panel>
                </VBox>
                <VBox>
                  <Panel headerText="Subscription Summary" expandable="false" expanded="true">
                    <content>
                      <form:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                        <Label text="Selected Plan" />
                        <Text text="{sub>/subscription/plan}" />
                        <Label text="Base Price" />
                        <Text text="{path: 'sub>/pricing/basePrice', formatter: '.formatCurrency'}" />
                        <Label text="Seat/Usage Cost" />
                        <Text text="{path: 'sub>/pricing/seatCost', formatter: '.formatCurrency'}" />
                        <Label text="Tax Amount" />
                        <Text text="{path: 'sub>/pricing/taxAmount', formatter: '.formatCurrency'}" />
                        <Label text="Total Cost" />
                        <Text text="{path: 'sub>/pricing/totalCost', formatter: '.formatCurrency'}" />
                        <Label text="Billing Cycle" />
                        <ObjectStatus text="{sub>/pricing/billingCycle}" state="None" />
                        <Label text="Next Billing Date" />
                        <Text text="{sub>/pricing/nextBillingDate}" />
                        <Label text="Status" />
                        <ObjectStatus text="{sub>/status/current}" state="None" />
                      </form:SimpleForm>
                    </content>
                  </Panel>
                </VBox>
              </HBox>
            </content>
          </Panel>

          <!-- Vertical: Billing Information -->
          <Panel headerText="Billing Information" expandable="true" expanded="true" class="sapUiSmallMarginBottom" visible="{path: 'sub>/horizontalLayoutMode', formatter: '.formatInverted'}">
            <content>
              <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                <Label text="Currency" />
                <Select selectedKey="{sub>/billing/currency}" change=".onCurrencyChange">
                  <items>
                    <core:Item key="EUR" text="EUR" />
                    <core:Item key="USD" text="USD" />
                    <core:Item key="GBP" text="GBP" />
                  </items>
                </Select>
                <Label text="Tax Rate (%)" />
                <Input value="{sub>/billing/taxRate}" type="Number" placeholder="20" liveChange=".onTaxChange" />
                <Label text="Tax Exempt" />
                <CheckBox selected="{sub>/billing/taxExempt}" select=".onTaxExemptChange" />
                <Label text="Invoice Frequency" />
                <Select selectedKey="{sub>/billing/invoiceFrequency}">
                  <items>
                    <core:Item key="monthly" text="Monthly" />
                    <core:Item key="quarterly" text="Quarterly" />
                    <core:Item key="annually" text="Annually" />
                  </items>
                </Select>
                <Label text="Payment Method" />
                <Select selectedKey="{sub>/billing/paymentMethod}" change=".onPaymentMethodChange">
                  <items>
                    <core:Item key="creditcard" text="Credit Card" />
                    <core:Item key="banktransfer" text="Bank Transfer" />
                    <core:Item key="paypal" text="PayPal" />
                    <core:Item key="invoice" text="Invoice" />
                  </items>
                </Select>
                <Label text="PO Number" />
                <Input value="{sub>/billing/poNumber}" placeholder="PO-12345" />
                <Label text="Billing Contact" />
                <Input value="{sub>/billing/billingContact}" placeholder="Billing Contact" />
                <Label text="Billing Email" />
                <Input value="{sub>/billing/billingEmail}" type="Email" placeholder="billing@company.com" />
              </form:SimpleForm>
            </content>
          </Panel>

          <!-- Vertical: Payment Method Details -->
          <Panel headerText="Payment Method Details" expandable="true" expanded="true" class="sapUiSmallMarginBottom" visible="{path: 'sub>/horizontalLayoutMode', formatter: '.formatInverted'}">
            <content>
              <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                <Label text="Card Number" />
                <Input value="{sub>/payment/cardNumber}" placeholder="**** **** **** 1234" />
                <Label text="Card Expiry" />
                <Input value="{sub>/payment/cardExpiry}" placeholder="MM/YY" />
                <Label text="Card CVV" />
                <Input value="{sub>/payment/cardCvv}" placeholder="***" />
                <Label text="Bank Account" />
                <Input value="{sub>/payment/bankAccount}" placeholder="IBAN" />
                <Label text="Bank BIC/SWIFT" />
                <Input value="{sub>/payment/bankBic}" placeholder="BIC/SWIFT" />
                <Label text="PayPal Email" />
                <Input value="{sub>/payment/paypalEmail}" type="Email" placeholder="paypal@company.com" />
              </form:SimpleForm>
            </content>
          </Panel>

          <!-- Subscription History -->
          <Panel headerText="Subscription History" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
            <content>
              <Table id="historyTable" mode="None">
                <columns>
                  <Column><Text text="Date" /></Column>
                  <Column><Text text="Action" /></Column>
                  <Column><Text text="Plan" /></Column>
                  <Column><Text text="Amount" /></Column>
                  <Column><Text text="Status" /></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="2026-01-15" />
                      <Text text="Subscription Created" />
                      <Text text="Professional" />
                      <Text text="€299" />
                      <ObjectStatus text="Active" state="Success" />
                    </cells>
                  </ColumnListItem>
                  <ColumnListItem>
                    <cells>
                      <Text text="2026-02-15" />
                      <Text text="Renewal" />
                      <Text text="Professional" />
                      <Text text="€299" />
                      <ObjectStatus text="Completed" state="Success" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </content>
          </Panel>

          <!-- Validation Message Strip -->
          <MessageStrip id="validationMessage" text="" type="Error" showIcon="true" visible="false" />
        </content>
        <footer>
          <Toolbar>
            <ToolbarSpacer />
            <Button text="Calculate" press=".onCalculate" />
            <Button text="Reset" press=".onReset" />
            <Button text="Save Subscription" type="Emphasized" press=".onSave" />
          </Toolbar>
        </footer>
      </Page>
    </pages>
  </App>
</mvc:View>
