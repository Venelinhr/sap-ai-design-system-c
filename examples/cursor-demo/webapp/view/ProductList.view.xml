<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  controllerName="cursor.demo.controller.ProductList"
  displayBlock="true"
  height="100%">
  <App id="productListApp">
    <pages>
      <Page
        id="productListPage"
        title="Products"
        showNavButton="false"
        enableScrolling="true"
        backgroundDesign="Standard"
        class="sapUiContentPadding">
        <content>
          <Table
            id="productTable"
            mode="None"
            backgroundDesign="Solid"
            fixedLayout="false"
            items="{product>/items}">
            <columns>
              <Column>
                <header>
                  <Text text="Name" />
                </header>
              </Column>
              <Column>
                <header>
                  <Text text="Price" />
                </header>
              </Column>
              <Column>
                <header>
                  <Text text="Availability" />
                </header>
              </Column>
            </columns>
            <items>
              <ColumnListItem type="Inactive">
                <cells>
                  <Text text="{product>name}" />
                  <Text text="{product>price}" />
                  <Text text="{product>availability}" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
          <Toolbar design="Transparent">
            <ToolbarSpacer />
            <Button
              id="addToCartButton"
              text="Add to Cart"
              type="Emphasized"
              press=".onAddToCart" />
          </Toolbar>
        </content>
      </Page>
    </pages>
  </App>
</mvc:View>
