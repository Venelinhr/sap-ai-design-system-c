<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" xmlns="sap.m" controllerName="subdemo.controller.Subscription" displayBlock="true" height="100%"><App id="subApp" busyIndicatorDelay="0"><pages><Page title="B2B Subscription Management" class="sapUiContentPadding" showNavButton="false" enableScrolling="true" backgroundDesign="Standard"><content><MessageStrip text="Manage B2B subscriptions with comprehensive billing, pricing, and payment options." type="Information" showIcon="true" class="sapUiSmallMarginBottom"/><Panel headerText="Layout Options" expandable="false" expanded="true" class="sapUiSmallMarginBottom"><content><HBox alignItems="Center"><Text text="Horizontal Layout Mode: " class="sapUiSmallMarginEnd"/><Switch state="{sub>/horizontalLayoutMode}" change=".onLayoutToggle"/></HBox></content></Panel><Panel headerText="Subscriber &amp; Subscription Details" expandable="false" expanded="true" class="sapUiSmallMarginBottom" visible="{sub>/horizontalLayoutMode}"><content><HBox><VBox class="sapUiSmallMarginEnd" width="50%"><Panel headerText="Subscriber Information" expandable="false" expanded="true"><content><form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1"><Label text="Company Name"/><Input value="{sub>/subscriber/companyName}" placeholder="Company Name"/><Label text="Email"/><Input value="{sub>/subscriber/email}" type="Email" placeholder="contact@company.com"/><Label text="Phone"/><Input value="{sub>/subscriber/phone}" type="Tel" placeholder="+1 234 567 890"/><Label text="Address"/><TextArea value="{sub>/subscriber/address}" rows="2" placeholder="Street, City, Country"/></form:SimpleForm></content></Panel></VBox><VBox width="50%"><Panel headerText="Subscription Details" expandable="false" expanded="true"><content><form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="1"><Label text="Plan"/><ComboBox selectedKey="{sub>/subscription/plan}" change=".onPlanChange"><items><core:Item key="basic" text="Basic"/><core:Item key="professional" text="Professional"/><core:Item key="enterprise" text="Enterprise"/></items></ComboBox><Label text="Billing Frequency"/><Select selectedKey="{sub>/subscription/billingFrequency}" change=".onBillingChange"><items><core:Item key="monthly" text="Monthly"/><core:Item key="quarterly" text="Quarterly"/><core:Item key="annually" text="Annually"/></items></Select><Label text="Start Date"/><DatePicker value="{sub>/subscription/startDate}" change=".onDateChange"/><Label text="Auto-renew"/><Switch state="{sub>/subscription/autoRenew}" change=".onAutoRenewChange"/></form:SimpleForm></content></Panel></VBox></HBox></content></Panel><Panel headerText="Plan Comparison" expandable="false" expanded="true" class="sapUiSmallMarginBottom"><content><Table mode="SingleSelect" selectionChange=".onPlanSelect"><columns><Column><Text text="Plan"/></Column><Column><Text text="Features"/></Column><Column><Text text="Price/Month"/></Column></columns><items><ColumnListItem type="Active"><cells><Text text="Basic"/><Text text="10 users, Basic support"/><Text text="€99"/></cells></ColumnListItem><ColumnListItem type="Active"><cells><Text text="Professional"/><Text text="50 users, Priority support"/><Text text="€299"/></cells></ColumnListItem><ColumnListItem type="Active"><cells><Text text="Enterprise"/><Text text="Unlimited, 24/7 support"/><Text text="€999"/></cells></ColumnListItem></items></Table></content></Panel><Panel headerText="Billing &amp; Summary" expandable="true" expanded="true" class="sapUiSmallMarginBottom" visible="{sub>/horizontalLayoutMode}"><content><HBox><VBox class="sapUiSmallMarginEnd"><Panel headerText="Billing Information" expandable="false" expanded="true"><content><form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4"><Label text="Currency"/><Select selectedKey="{sub>/billing/currency}" change=".onCurrencyChange"><items><core:Item key="EUR" text="EUR"/><core:Item key="USD" text="USD"/><core:Item key="GBP" text="GBP"/></items></Select><Label text="Tax Rate (%)"/><Input value="{sub>/billing/taxRate}" type="Number" liveChange=".onTaxChange"/><Label text="Payment Method"/><Select selectedKey="{sub>/billing/paymentMethod}" change=".onPaymentMethodChange"><items><core:Item key="creditcard" text="Credit Card"/><core:Item key="banktransfer" text="Bank Transfer"/><core:Item key="paypal" text="PayPal"/></items></Select></form:SimpleForm></content></Panel></VBox><VBox><Panel headerText="Summary" expandable="false" expanded="true"><content><form:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4"><Label text="Plan"/><Text text="{sub>/subscription/plan}"/><Label text="Base Price"/><Text text="{path: 'sub>/pricing/basePrice', formatter: '.formatCurrency'}"/><Label text="Total Cost"/><Text text="{path: 'sub>/pricing/totalCost', formatter: '.formatCurrency'}"/><Label text="Status"/><ObjectStatus text="{sub>/status/current}"/></form:SimpleForm></content></Panel></VBox></HBox></content></Panel></content><footer><Toolbar><ToolbarSpacer/><Button text="Calculate" press=".onCalculate"/><Button text="Save" type="Emphasized" press=".onSave"/></Toolbar></footer></Page></pages></App></mvc:View>
