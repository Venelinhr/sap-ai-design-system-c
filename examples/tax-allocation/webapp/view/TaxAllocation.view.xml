<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  xmlns="sap.m"
  controllerName="taxalloc.controller.TaxAllocation"
  displayBlock="true"
  height="100%">
  <App id="taxApp" busyIndicatorDelay="0">
    <pages>
      <Page
        title="Tax Allocation"
        class="sapUiContentPadding"
        showNavButton="false"
        enableScrolling="true"
        backgroundDesign="Standard">
        <content>
          <MessageStrip
            text="Allocate amounts across tax categories for personal and business tax. Total allocations must equal 100%."
            type="Information"
            showIcon="true"
          />

          <!-- Tax Payer Information Panel -->
          <Panel headerText="Tax Payer Information" expandable="false" expanded="true">
            <content>
              <form:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="0"
                columnsXL="2"
                columnsL="2"
                columnsM="1"
                singleContainerFullSize="false">
                <Label text="Allocation ID" />
                <Input value="{taxalloc>/allocationId}" placeholder="TAX-2026-001" />

                <Label text="Taxpayer Name" />
                <Input value="{taxalloc>/taxpayerName}" required="true" placeholder="Company Name or Individual" />

                <Label text="Taxpayer Type" />
                <Select selectedKey="{taxalloc>/taxpayerType}" change=".onTaxTypeChange">
                  <items>
                    <core:Item key="business" text="Business" />
                    <core:Item key="personal" text="Personal" />
                  </items>
                </Select>

                <Label text="Tax Year" />
                <Input value="{taxalloc>/taxYear}" placeholder="2026" />

                <Label text="Status" />
                <ObjectStatus text="{taxalloc>/status}" state="None" />
              </form:SimpleForm>
            </content>
          </Panel>

          <!-- Allocation Details Panel -->
          <Panel headerText="Allocation Details" expandable="false" expanded="true">
            <content>
              <form:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="0"
                columnsXL="2"
                columnsL="2"
                columnsM="1"
                singleContainerFullSize="false">
                <Label text="Total Amount (€)" />
                <Input value="{taxalloc>/totalAmount}" type="Number" placeholder="0.00" liveChange=".onTotalAmountChange" />

                <Label text="Currency" />
                <Select selectedKey="{taxalloc>/currency}" enabled="false">
                  <items>
                    <core:Item key="EUR" text="EUR" />
                  </items>
                </Select>

                <Label text="Auto-calculate" />
                <Switch state="{taxalloc>/autoCalculate}" />

                <Label text="Notes" />
                <TextArea value="{taxalloc>/notes}" rows="2" placeholder="Additional notes..." />
              </form:SimpleForm>
            </content>
          </Panel>

          <!-- Allocation Line Items Panel -->
          <Panel headerText="Allocation Line Items" expandable="false" expanded="true">
            <content>
              <Toolbar>
                <ToolbarSpacer />
                <Button text="Add Allocation" type="Emphasized" press=".onAddAllocation" icon="sap-icon://add" />
              </Toolbar>
              <Table
                id="allocationsTable"
                mode="Delete"
                items="{taxalloc>/allocations}"
                delete=".onDeleteAllocation">
                <columns>
                  <Column width="20%">
                    <Text text="Category" />
                  </Column>
                  <Column width="25%">
                    <Text text="Description" />
                  </Column>
                  <Column width="15%">
                    <Text text="Amount (€)" />
                  </Column>
                  <Column width="10%">
                    <Text text="%" />
                  </Column>
                  <Column width="10%">
                    <Text text="Tax Rate" />
                  </Column>
                  <Column width="15%">
                    <Text text="Tax Amount (€)" />
                  </Column>
                </columns>
                <items>
                  <ColumnListItem type="Active">
                    <cells>
                      <Select selectedKey="{taxalloc>category}" change=".onAllocationChange">
                        <items>
                          <core:Item key="income" text="Income Tax" />
                          <core:Item key="vat" text="VAT" />
                          <core:Item key="corporate" text="Corporate Tax" />
                          <core:Item key="property" text="Property Tax" />
                          <core:Item key="withholding" text="Withholding Tax" />
                          <core:Item key="other" text="Other" />
                        </items>
                      </Select>
                      <Input value="{taxalloc>description}" placeholder="Description" liveChange=".onAllocationChange" />
                      <Input value="{taxalloc>amount}" type="Number" placeholder="0.00" liveChange=".onAllocationChange" />
                      <Text text="{parts: [{path: 'taxalloc>amount'}, {path: 'taxalloc>/totalAmount'}], formatter: '.formatPercentage'}" />
                      <Input value="{taxalloc>taxRate}" type="Number" placeholder="0" liveChange=".onAllocationChange" />
                      <Text text="{parts: [{path: 'taxalloc>amount'}, {path: 'taxalloc>taxRate'}], formatter: '.formatTaxAmount'}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </content>
          </Panel>

          <!-- Summary Panel -->
          <Panel headerText="Summary" expandable="false" expanded="true">
            <content>
              <form:SimpleForm
                editable="false"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="0"
                columnsXL="2"
                columnsL="2"
                columnsM="1"
                singleContainerFullSize="false">
                <Label text="Total Allocated (€)" />
                <Text text="{path: 'taxalloc>/totalAllocated', formatter: '.formatCurrency'}" />

                <Label text="Total Tax (€)" />
                <Text text="{path: 'taxalloc>/totalTax', formatter: '.formatCurrency'}" />

                <Label text="Allocation Status" />
                <ObjectStatus text="{parts: [{path: 'taxalloc>/totalAllocated'}, {path: 'taxalloc>/totalAmount'}], formatter: '.formatAllocationStatus'}" state="{parts: [{path: 'taxalloc>/totalAllocated'}, {path: 'taxalloc>/totalAmount'}], formatter: '.formatAllocationState'}" />

                <Label text="Remaining Amount (€)" />
                <Text text="{parts: [{path: 'taxalloc>/totalAmount'}, {path: 'taxalloc>/totalAllocated'}], formatter: '.formatRemaining'}" />
              </form:SimpleForm>
            </content>
          </Panel>

          <!-- Validation Message Strip -->
          <MessageStrip
            id="validationMessage"
            text=""
            type="Error"
            showIcon="true"
            visible="false"
          />
        </content>
        <footer>
          <Toolbar>
            <ToolbarSpacer />
            <Button text="Add Allocation" press=".onAddAllocation" />
            <Button text="Calculate" press=".onCalculate" />
            <Button text="Reset" press=".onReset" />
            <Button text="Save" type="Emphasized" press=".onSave" />
          </Toolbar>
        </footer>
      </Page>
    </pages>
  </App>
</mvc:View>
