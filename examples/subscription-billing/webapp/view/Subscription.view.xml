<mvc:View
  controllerName="subbilling.controller.Subscription"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.uxap"
  xmlns:m="sap.m"
  xmlns:form="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  height="100%"
>
  <m:App id="subApp" class="sapUiSizeCompact">
    <m:pages>
      <ObjectPageLayout
        id="subOpl"
        showTitleInHeaderContent="true"
        alwaysShowContentHeader="true"
        headerContentPinnable="true"
        preserveHeaderStateOnScroll="true"
        useIconTabBar="false"
        showFooter="false"
        upperCaseAnchorBar="false"
      >
        <headerTitle>
          <ObjectPageDynamicHeaderTitle>
            <expandedHeading>
              <m:HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginEnd">
                <m:Title text="{/company}" level="H2" wrapping="true" />
                <m:ObjectStatus
                  class="sapUiSmallMarginBegin"
                  text="{/subscriptionState}"
                  state="{/subscriptionStateS}"
                />
                <m:Text
                  class="sapUiSmallMarginBegin"
                  text="Tenant: {/companyId}"
                />
              </m:HBox>
            </expandedHeading>
            <snappedHeading>
              <m:Title text="Subscription" level="H3" />
            </snappedHeading>
            <actions>
              <m:Button text="Unsubscribe" type="Negative" press=".onOpenUnsub" />
              <m:Button text="Re-subscribe" type="Emphasized" press=".onOpenResub" />
            </actions>
          </ObjectPageDynamicHeaderTitle>
        </headerTitle>
        <headerContent>
          <m:OverflowToolbar design="Solid">
            <m:Text text="{/planName}" wrapping="true" class="sapUiSmallMargin" />
            <m:ToolbarSpacer />
            <m:ObjectStatus text="{/quoteRef}" state="Indication10" active="true" />
          </m:OverflowToolbar>
          <m:MessageStrip
            text="{/lifecycleNote}"
            type="{/messageStripType}"
            showIcon="true"
            class="sapUiSmallMargin"
          />
          <!-- Do not use OverflowToolbar for multi-line VBox: it clips (fixed height). Use a plain HBox. -->
          <!-- One row, no wrap: pre-fix logs showed both blocks at left:48 with actions on next line (wrap). -->
          <m:HBox
            id="hdrOuterHBox"
            class="sapUiContentPadding"
            width="100%"
            alignItems="Center"
            justifyContent="SpaceBetween"
            wrap="false"
            renderType="Div"
          >
            <m:HBox
              id="hdrFormRow"
              alignItems="Center"
              class="sapUiSmallMargin"
              renderType="Bare"
              wrap="false"
            >
              <m:layoutData>
                <m:FlexItemData growFactor="1" shrinkFactor="1" minWidth="0" />
              </m:layoutData>
              <m:Label
                id="hdrLblContract"
                text="Contract / order ref."
                design="Standard"
                textAlign="End"
                width="12rem"
                class="sapUiSmallMarginEnd"
                wrapping="true"
              />
              <m:VBox id="hdrValuesVBox" alignItems="Start" renderType="Bare">
                <m:Title
                  id="hdrTitleContract"
                  text="{/contractId}"
                  level="H4"
                  wrapping="true"
                />
                <m:Text
                  id="hdrTxtPlan"
                  text="Plan code: {/planCode}"
                  wrapping="true"
                  class="sapUiTinyMarginTop"
                />
              </m:VBox>
            </m:HBox>
            <m:HBox
              id="hdrActionsHBox"
              class="sapUiSmallMargin"
              alignItems="Center"
              renderType="Bare"
              wrap="false"
            >
              <m:layoutData>
                <m:FlexItemData growFactor="0" shrinkFactor="0" />
              </m:layoutData>
              <m:Button
                icon="sap-icon://refresh"
                tooltip="Simulate BFF balance refresh"
                press=".onRefresh"
                type="Transparent"
              />
              <m:Button
                icon="sap-icon://undo"
                text="Reset demo"
                press=".onResetDemo"
                type="Transparent"
                class="sapUiTinyMarginEnd"
              />
              <m:SearchField
                width="12rem"
                placeholder="Filter services (no-op demo)…"
              />
            </m:HBox>
          </m:HBox>
        </headerContent>
        <sections>
          <ObjectPageSection title="Plan &amp; contract" id="secPlan">
            <subSections>
              <ObjectPageSubSection title="Commercial snapshot (read-only)">
                <blocks>
                  <m:VBox id="keyFiguresBlock" width="100%" alignItems="Stretch">
                    <m:Title
                      id="keyFiguresSecTitle"
                      text="Key figures"
                      level="H3"
                      class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop"
                    />
                    <m:Toolbar id="keyFiguresTb" design="Info" width="100%">
                      <m:Title text="SAP CPQ + CLM hand-off" level="H5" />
                      <m:ToolbarSpacer />
                      <m:Text text="MRR in EUR · seats = named users" />
                    </m:Toolbar>
                    <form:SimpleForm
                      id="keyFiguresForm"
                      editable="false"
                      width="100%"
                      layout="ResponsiveGridLayout"
                      labelSpanXL="3"
                      labelSpanL="3"
                      labelSpanM="4"
                      adjustLabelSpan="true"
                      emptySpanXL="0"
                      emptySpanL="0"
                      emptySpanM="0"
                      columnsXL="1"
                      columnsL="1"
                      columnsM="1"
                      singleContainerFullSize="true"
                    >
                      <m:Label text="Service start" />
                      <m:Text text="{/plan/start}" />
                      <m:Label text="Next renewal" />
                      <m:Text text="{/plan/renewal}" />
                      <m:Label text="Seats" />
                      <m:ObjectNumber number="{/plan/seats}" unit="NUs" state="None" />
                      <m:Label text="MRR (indicative)" />
                      <m:ObjectNumber number="{/plan/mrr}" unit="EUR" state="Success" />
                      <m:Label text="ACV (contract)" />
                      <m:ObjectNumber number="{/plan/annualCommit}" unit="EUR" state="None" />
                    </form:SimpleForm>
                  </m:VBox>
                </blocks>
              </ObjectPageSubSection>
            </subSections>
          </ObjectPageSection>
          <ObjectPageSection title="Approval pipeline" id="secAppr">
            <subSections>
              <ObjectPageSubSection title="Stage gate — subscription lifecycle">
                <blocks>
                  <m:VBox id="stgApprBlock" width="100%" alignItems="Stretch">
                    <m:Title
                      id="stgApprTitle"
                      text="Progress"
                      level="H3"
                      class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop"
                    />
                    <m:MessageStrip
                      id="msgStageGate"
                      type="Information"
                      showIcon="true"
                      text="Mirrors a simple workflow: sales → PO → security → enablement. Progress is a mock — plug into SAP Build Process Automation in real life."
                      class="sapUiSmallMarginBottom"
                    />
                    <m:VBox
                      id="stgApprPIWrap"
                      width="100%"
                      class="sapUiSmallMarginBottom"
                    >
                      <m:Text
                        id="stgApprSubtext"
                        text="{/approval/label}"
                        wrapping="true"
                        class="sapUiSmallMarginBottom"
                      />
                      <m:ProgressIndicator
                        id="stgApprBar"
                        percentValue="{/approval/percent}"
                        showValue="true"
                        state="None"
                        displayValue="{path: '/approval/percent', formatter: '.formatApprovalPercent'}"
                        width="100%"
                        class="sapUiSmallMarginBottom"
                      />
                    </m:VBox>
                    <m:Table
                      id="stagesTbl"
                      width="100%"
                      inset="false"
                      items="{/stages}"
                      mode="None"
                    >
                    <m:columns>
                      <m:Column width="5rem" minWidth="3rem" hAlign="Center"><m:Text text="#" /></m:Column>
                      <m:Column minWidth="10rem" width="20%"><m:Text text="Gate" /></m:Column>
                      <m:Column minWidth="6rem" width="12%"><m:Text text="State" /></m:Column>
                      <m:Column minWidth="7rem" width="14%"><m:Text text="Date / info" /></m:Column>
                      <m:Column minWidth="14rem" width="44%"><m:Text text="Actor / system" /></m:Column>
                    </m:columns>
                    <m:items>
                      <m:ColumnListItem vAlign="Top">
                        <m:cells>
                          <m:Text text="{order}" />
                          <m:Text text="{name}" maxLines="3" />
                          <m:ObjectStatus text="{status}" state="{state}" />
                          <m:Text text="{when}" />
                          <m:Text text="{who}" maxLines="2" />
                        </m:cells>
                      </m:ColumnListItem>
                    </m:items>
                  </m:Table>
                </m:VBox>
                </blocks>
              </ObjectPageSubSection>
            </subSections>
          </ObjectPageSection>
          <ObjectPageSection title="Subscribed services" id="secLines">
            <subSections>
              <ObjectPageSubSection title="Line items (company view)">
                <blocks>
                  <m:VBox id="lineItemsBlock" width="100%" alignItems="Stretch">
                    <m:Toolbar design="Info" width="100%">
                      <m:Text text="5 items · 3 billing rhythms · 1 open true-up" />
                      <m:ToolbarSpacer />
                      <m:Button
                        type="Emphasized"
                        text="Download quote PDF"
                        icon="sap-icon://pdf-attachment"
                        enabled="false"
                      />
                    </m:Toolbar>
                    <m:Table
                      id="lineTbl"
                      width="100%"
                      inset="false"
                      items="{/lineItems}"
                      growing="true"
                      growingThreshold="8"
                      mode="None"
                    >
                    <m:columns>
                      <m:Column width="20%" minWidth="12rem">
                        <m:Text text="Product" />
                      </m:Column>
                      <m:Column width="8%" minWidth="5rem">
                        <m:Text text="SKU" />
                      </m:Column>
                      <m:Column width="12%" minWidth="7rem">
                        <m:Text text="Cycle" />
                      </m:Column>
                      <m:Column hAlign="End" width="12%" minWidth="8rem">
                        <m:Text text="Price / period" />
                      </m:Column>
                      <m:Column width="10%" minWidth="7rem">
                        <m:Text text="Next charge" />
                      </m:Column>
                      <m:Column hAlign="Center" width="12%" minWidth="7rem">
                        <m:Text text="Item status" />
                      </m:Column>
                      <m:Column width="8%" minWidth="5rem">
                        <m:Text text="Tax" />
                      </m:Column>
                    </m:columns>
                    <m:items>
                      <m:ColumnListItem vAlign="Top" type="Inactive">
                        <m:cells>
                          <m:Text text="{product}" maxLines="3" />
                          <m:ObjectIdentifier title="{sku}" />
                          <m:Text text="{cycle}" />
                          <m:ObjectNumber number="{price}" unit="EUR" state="None" />
                          <m:Text text="{next}" />
                          <m:ObjectStatus text="{liText}" state="{liState}" />
                          <m:Text text="{tax}" />
                        </m:cells>
                      </m:ColumnListItem>
                    </m:items>
                  </m:Table>
                  </m:VBox>
                </blocks>
              </ObjectPageSubSection>
            </subSections>
          </ObjectPageSection>
          <ObjectPageSection title="Balance &amp; payment" id="secMoney">
            <subSections>
              <ObjectPageSubSection title="Ledger view (illustrative)">
                <blocks>
                  <m:VBox id="workCapBlock" width="100%" alignItems="Stretch">
                    <m:Title
                      id="workCapTitle"
                      text="Working capital (subscription billing)"
                      level="H3"
                      class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop"
                    />
                    <form:SimpleForm
                      id="workCapForm"
                      editable="false"
                      width="100%"
                      layout="ResponsiveGridLayout"
                      labelSpanXL="4"
                      labelSpanL="4"
                      labelSpanM="5"
                      adjustLabelSpan="true"
                      emptySpanXL="0"
                      emptySpanL="0"
                      emptySpanM="0"
                      columnsXL="1"
                      columnsL="1"
                      columnsM="1"
                      singleContainerFullSize="true"
                    >
                        <m:Label text="Prepaid balance" />
                        <m:ObjectNumber
                          number="{/balance/prepaid}"
                          unit="{/balance/currency}"
                          state="Success"
                        />
                        <m:Label text="Unbilled (usage + variable)" />
                        <m:ObjectNumber
                          number="{/balance/unbilled}"
                          unit="{/balance/currency}"
                          state="Warning"
                        />
                        <m:Label text="Open invoices" />
                        <m:ObjectNumber
                          number="{/balance/openInv}"
                          unit="{/balance/currency}"
                          state="Success"
                        />
                        <m:Label text="Credit notes on file" />
                        <m:ObjectNumber
                          number="{/balance/creditNotes}"
                          unit="{/balance/currency}"
                          state="None"
                        />
                        <m:Label text="Next invoice (floor)" />
                        <m:HBox alignItems="Center" wrap="Wrap">
                          <m:Text text="{/balance/nextInvoiceDate}" class="sapUiSmallMarginEnd" />
                          <m:ObjectNumber
                            number="{/balance/nextInvoiceMin}"
                            unit="{/balance/currency}"
                            state="None"
                          />
                        </m:HBox>
                        <m:Label text="Payment method" />
                        <m:Text text="{/balance/method}" />
                        <m:Label text="Billing account" />
                        <m:Text text="{/balance/billingAccount}" />
                        <m:Label text="Tax registration" />
                        <m:Text text="{/balance/taxId}" />
                    </form:SimpleForm>
                  </m:VBox>
                </blocks>
              </ObjectPageSubSection>
            </subSections>
          </ObjectPageSection>
        </sections>
      </ObjectPageLayout>
    </m:pages>
  </m:App>
</mvc:View>
